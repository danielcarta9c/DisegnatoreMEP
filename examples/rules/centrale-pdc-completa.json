{"assumptions":[],"components":[{"definition_id":"air-separator","evidence":[{"kind":"rule","note":"L'aria disciolta si libera dove l'acqua e' piu' calda: il separatore la raccoglie sulla mandata, prima che raggiunga i terminali.","reference":"air-separator-on-generator-flow@1.0.0"}],"id":"air-separator-hp-water-supply","properties":{},"tag":null},{"definition_id":"buffer-four-port","evidence":[],"id":"buffer","properties":{"volume_l":200},"tag":"VOL-01"},{"definition_id":"dhw-cylinder","evidence":[],"id":"cylinder","properties":{"volume_l":300},"tag":"BOL-01"},{"definition_id":"dirt-separator","evidence":[{"kind":"rule","note":"I residui di montaggio e le ossidazioni tornano al generatore: il defangatore li trattiene prima dello scambiatore.","reference":"dirt-separator-on-generator-return@1.0.0"}],"id":"dirt-separator-hp-water-return","properties":{},"tag":null},{"definition_id":"drain-connection","evidence":[{"kind":"rule","note":"Un accumulo va potuto svuotare per la manutenzione senza scaricare l'intero impianto.","reference":"drain-on-storage@1.0.0"}],"id":"drain-connection-buffer-primary-in","properties":{},"tag":null},{"definition_id":"dhw-draw-off","evidence":[],"id":"draw-off","properties":{},"tag":"ACS-01"},{"definition_id":"diverting-valve-3way","evidence":[],"id":"dv","properties":{},"tag":"VD-01"},{"definition_id":"expansion-connection-dhw","evidence":[{"kind":"rule","note":"Con il ritegno installato la dilatazione non ha piu' dove andare: il vaso sanitario evita che la valvola di sicurezza sgoccioli a ogni ciclo.","reference":"dhw-expansion-on-cold-inlet@1.0.0"}],"id":"expansion-connection-dhw-cylinder-cold-in","properties":{},"tag":null},{"definition_id":"expansion-connection","evidence":[{"kind":"rule","note":"Un circuito chiuso deve poter dilatare senza salire in pressione: il vaso assorbe l'aumento di volume dell'acqua scaldata.","reference":"expansion-on-closed-circuit@1.0.0"}],"id":"expansion-connection-hp-water-return","properties":{},"tag":null},{"definition_id":"filling-unit","evidence":[{"kind":"rule","note":"L'impianto va riempito e reintegrato a pressione controllata, e il ritorno e' il punto piu' freddo in cui farlo.","reference":"filling-unit-on-return@1.0.0"}],"id":"filling-unit-hp-water-return","properties":{},"tag":null},{"definition_id":"heat-pump-air-water","evidence":[],"id":"hp","properties":{},"tag":"PDC-01"},{"definition_id":"cold-water-inlet","evidence":[],"id":"mains","properties":{},"tag":"AF-01"},{"definition_id":"zone-manifold","evidence":[],"id":"manifold","properties":{},"tag":"COL-01"},{"definition_id":"mixing-valve-thermostatic","evidence":[{"kind":"rule","note":"L'accumulo si tiene caldo contro la legionella, ma alle utenze l'acqua deve arrivare a temperatura di utilizzo: la miscelatrice separa le due cose.","reference":"dhw-mixing-on-draw-off@1.0.0"}],"id":"mixing-valve-thermostatic-cylinder-dhw-out","properties":{},"tag":null},{"definition_id":"pressure-gauge","evidence":[{"kind":"rule","note":"La pressione dell'impianto va letta sul posto: e' la prima cosa che si guarda quando qualcosa non va.","reference":"pressure-gauge-on-generator-return@1.0.0"}],"id":"pressure-gauge-hp-water-return","properties":{},"tag":null},{"definition_id":"pump-circulator","evidence":[],"id":"pump-secondary","properties":{"flow_rate_m3h":1.2},"tag":"CIR-02"},{"definition_id":"radiator","evidence":[],"id":"radiators","properties":{},"tag":"RAD-01"},{"definition_id":"valve-isolation","evidence":[],"id":"shutoff","properties":{},"tag":"VI-01"},{"definition_id":"strainer","evidence":[],"id":"strainer","properties":{},"tag":"FIL-01"},{"definition_id":"strainer","evidence":[{"kind":"rule","note":"Il filtro protegge la girante dai residui che restano in impianto dopo il montaggio.","reference":"strainer-upstream-of-pump@1.0.0"}],"id":"strainer-pump-secondary-a","properties":{},"tag":null},{"definition_id":"thermometer","evidence":[{"kind":"rule","note":"La temperatura di mandata va letta sul posto, senza smontare nulla.","reference":"thermometer-on-generator-flow@1.0.0"}],"id":"thermometer-hp-water-supply","properties":{},"tag":null},{"definition_id":"underfloor-panel","evidence":[],"id":"underfloor","properties":{},"tag":"PAV-01"},{"definition_id":"valve-check-dhw","evidence":[{"kind":"rule","note":"L'acqua calda non deve poter risalire nella rete di alimentazione fredda.","reference":"dhw-check-on-cold-inlet@1.0.0"}],"id":"valve-check-dhw-cylinder-cold-in","properties":{},"tag":null},{"definition_id":"valve-isolation","evidence":[{"kind":"rule","note":"Un accumulo si sostituisce e si manutiene: sezionarlo evita di svuotare l'impianto per lavorarci. Una sola valvola nel primo pacchetto: sezionare ogni attacco e' corretto ma raddoppia gli accessori, e resta fra gli sviluppi futuri.","reference":"isolation-around-storage@1.0.0"}],"id":"valve-isolation-buffer-primary-in","properties":{},"tag":null},{"definition_id":"valve-isolation","evidence":[{"kind":"rule","note":"Un circolatore e' il pezzo che si sostituisce piu' spesso: va sezionato sui due lati. Una sola valvola nel primo pacchetto: sezionare ogni attacco e' corretto ma raddoppia gli accessori, e resta fra gli sviluppi futuri.","reference":"isolation-around-pump@1.0.0"}],"id":"valve-isolation-pump-secondary-a","properties":{},"tag":null},{"definition_id":"valve-safety-dhw","evidence":[{"kind":"rule","note":"L'acqua che si scalda in un bollitore dilata, e il ritegno le impedisce di tornare in rete: senza scarico la pressione sale fino a rottura.","reference":"dhw-safety-group-on-cold-inlet@1.0.0"}],"id":"valve-safety-dhw-cylinder-cold-in","properties":{},"tag":null},{"definition_id":"valve-safety","evidence":[{"kind":"rule","note":"Il generatore deve poter scaricare la sovrapressione: la valvola apre prima che l'impianto raggiunga la pressione massima ammissibile.","reference":"safety-valve-on-generator@1.0.0"}],"id":"valve-safety-hp-water-supply","properties":{},"tag":null}],"connections":[{"endpoint_a":{"componen