  "assumptions": [
    {
      "id": "a1",
      "text": "La cascata con priorita' alla pompa di calore e' logica di regolazione, non topologia: sul grafo si vedono i due ritegni e il collettore che unisce i due generatori.",
      "status": "proposed"
    },
    {
      "id": "a2",
      "text": "La commutatrice sul ritorno della caldaia e' l'organo senza il quale il circuito sanitario non sarebbe dedicato: mentre fa sanitario la caldaia pescherebbe anche dal primario.",
      "status": "proposed"
    }
