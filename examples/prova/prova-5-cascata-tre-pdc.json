  "assumptions": [
    {
      "id": "a1",
      "text": "Il testo elenca **tre** circuiti secondari — batterie UTA, ventilconvettori e un circuito miscelato per il pavimento radiante. Il collettore disponibile ne serve due: il circuito miscelato non e' disegnato, ed e' una domanda per il progettista.",
      "status": "proposed"
    },
    {
      "id": "a2",
      "text": "Il ritorno del ricircolo e' innestato sulla mandata sanitaria: il testo dice solo che il ricircolo e' collegato al bollitore.",
      "status": "proposed"
    },
    {
      "id": "a3",
      "text": "La cascata rientra su tre ritorni distinti con due confluenze: il testo non descrive come le macchine rientrano.",
      "status": "proposed"
    }
  ],
