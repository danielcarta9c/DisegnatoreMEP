          "default": null,
          "title": "Dimensione"
        },
        "quota": {
          "default": "controsoffitto",
          "enum": [
            "controsoffitto",
            "traccia",
            "pavimento",
            "a_vista"
          ],
          "title": "Quota",
          "type": "string"
        },
        "fascio": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fascio"
        },
        "etichetta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Etichetta"
        }
      },
      "required": [
        "tratta",
        "da",
        "a",
        "fluido"
      ],
      "title": "Tracciato",
      "type": "object"
    }
