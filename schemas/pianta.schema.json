          "title": "Tratta",
          "type": "string"
        },
        "da": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/Estremo"
            }
          ],
          "title": "Da"
        },
        "a": {
          "anyOf": [
