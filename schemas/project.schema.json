{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "proposed",
        "approved",
        "rejected"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "AssumptionModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus",
          "default": "proposed"
        },
        "source_message_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Message Refs",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "AssumptionModel",
      "type": "object"
    },
    "BandAssignment": {
      "additionalProperties": false,
      "description": "Un sottosistema su una fascia della tavola, con la propria posizione.\n\nE' il piano di impaginazione che l'AI puo' scegliere (D-042): non coordinate,\nma un insieme ristretto di scelte discrete che il motore esegue e verifica.",
      "properties": {
        "subsystem_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Subsystem Id",
          "type": "string"
        },
        "band": {
          "$ref": "#/$defs/BandRole"
        },
        "order": {
          "default": 0,
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        }
      },
      "required": [
        "subsystem_id",
        "band"
      ],
      "title": "BandAssignment",
      "type": "object"
    },
    "BandRole": {
      "description": "Le fasce funzionali della tavola, dichiarate da sinistra a destra (D-041).\n\nL'ordine di dichiarazione **e'** l'ordine di lettura: i generatori a\nsinistra, la distribuzione a destra. Riordinare i membri riordina la tavola.",
      "enum": [
        "generation",
        "primary",
        "distribution",
        "terminal"
      ],
      "title": "BandRole",
      "type": "string"
    },
    "ComponentInstance": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "definition_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Definition Id",
          "type": "string"
        },
        "tag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tag"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Properties"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "definition_id"
      ],
      "title": "ComponentInstance",
      "type": "object"
    },
    "ConnectionModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "network_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Network Id",
          "type": "string"
        },
        "endpoint_a": {
          "$ref": "#/$defs/PortRef"
        },
        "endpoint_b": {
          "$ref": "#/$defs/PortRef"
        },
        "properties": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Properties"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "network_id",
        "endpoint_a",
        "endpoint_b"
      ],
      "title": "ConnectionModel",
      "type": "object"
    },
    "Domain": {
      "enum": [
        "hydronic",
        "aeraulic",
        "refrigerant",
        "gas",
        "condensate",
        "control"
      ],
      "title": "Domain",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "conversation",
            "attachment",
            "engineer",
            "rule"
          ],
          "title": "Kind",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "kind",
        "reference"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "IntegrationCategory": {
      "enum": [
        "necessary",
        "recommended",
        "conditional"
      ],
      "title": "IntegrationCategory",
      "type": "string"
    },
    "NetworkModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "medium": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Medium",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "domain",
        "medium"
      ],
      "title": "NetworkModel",
      "type": "object"
    },
    "PlantRegime": {
      "description": "Il regime della centrale: sotto o sopra i 35 kW (D-106).\n\nE' un **dato d'ingresso dichiarato dal progettista**, mai calcolato: la\ntaglia non la decide la skill (D-104), nemmeno sommando le potenze che il\ntesto nomina. La radice e' normativa: la Raccolta R si applica agli\nimpianti con potenza dei focolari superiore a 35 kW (cap. R.1.A.1,\nSRC-012); sotto quella soglia vale la buona pratica delle piccole\ncentrali, che e' un'altra (riscontro del 7 agosto su SRC-019 e SRC-008).\n\nUn progetto che non dichiara niente riceve il **corredo minimo**: le\nregole del regime piccolo si applicano, quelle del grande no. E' la\nscelta di D-106, non un valore inventato.",
      "enum": [
        "up_to_35_kw",
        "over_35_kw"
      ],
      "title": "PlantRegime",
      "type": "string"
    },
    "PortRef": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Component Id",
          "type": "string"
        },
        "port_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Port Id",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "port_id"
      ],
      "title": "PortRef",
      "type": "object"
    },
    "ProjectMetadata": {
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "client": {
          "minLength": 1,
          "title": "Client",
          "type": "string"
        },
        "project_name": {
          "minLength": 1,
          "title": "Project Name",
          "type": "string"
        },
        "commission_code": {
          "minLength": 1,
          "title": "Commission Code",
          "type": "string"
        },
        "revision": {
          "minLength": 1,
          "title": "Revision",
          "type": "string"
        },
        "issue_date": {
          "format": "date",
          "title": "Issue Date",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "client",
        "project_name",
        "commission_code",
        "revision",
        "issue_date"
      ],
      "title": "ProjectMetadata",
      "type": "object"
    },
    "RuleApplicationModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Rule Version",
          "type": "string"
        },
        "category": {
          "$ref": "#/$defs/IntegrationCategory"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus",
          "default": "proposed"
        },
        "entity_ids": {
          "items": {
            "type": "string"
          },
          "title": "Entity Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "rule_id",
        "rule_version",
        "category"
      ],
      "title": "RuleApplicationModel",
      "type": "object"
    },
    "SheetIntentModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "subsystem_ids": {
          "items": {
            "type": "string"
          },
          "title": "Subsystem Ids",
          "type": "array"
        },
        "band_assignments": {
          "items": {
            "$ref": "#/$defs/BandAssignment"
          },
          "title": "Band Assignments",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "SheetIntentModel",
      "type": "object"
    },
    "SubsystemModel": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "component_ids": {
          "items": {
            "type": "string"
          },
          "title": "Component Ids",
          "type": "array"
        },
        "network_ids": {
          "items": {
            "type": "string"
          },
          "title": "Network Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "SubsystemModel",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "1.1.0",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Schema Version",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ProjectMetadata"
    },
    "plant_regime": {
      "anyOf": [
        {
          "$ref": "#/$defs/PlantRegime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "subsystems": {
      "items": {
        "$ref": "#/$defs/SubsystemModel"
      },
      "title": "Subsystems",
      "type": "array"
    },
    "networks": {
      "items": {
        "$ref": "#/$defs/NetworkModel"
      },
      "title": "Networks",
      "type": "array"
    },
    "components": {
      "items": {
        "$ref": "#/$defs/ComponentInstance"
      },
      "title": "Components",
      "type": "array"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/ConnectionModel"
      },
      "title": "Connections",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "$ref": "#/$defs/AssumptionModel"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "rule_applications": {
      "items": {
        "$ref": "#/$defs/RuleApplicationModel"
      },
      "title": "Rule Applications",
      "type": "array"
    },
    "sheets": {
      "items": {
        "$ref": "#/$defs/SheetIntentModel"
      },
      "title": "Sheets",
      "type": "array"
    }
  },
  "required": [
    "metadata"
  ],
  "title": "ProjectModel",
  "type": "object"
}
