 "assumptions": [
  {
   "id": "a1",
   "text": "Chi regola: la pompa di calore con la regolazione a bordo. Sonde del bollitore e del volano e termostato ambiente sono cablati alla macchina, che comanda la deviatrice ACS e, tramite relè d'appoggio da 10 A nel quadro, il circolatore del secondario.",
   "status": "approved"
  },
  {
   "id": "a2",
   "text": "Un solo radiatore rappresenta i 3 radiatori di design, il radiatore verticale e i 3 scaldasalviette esistenti, tutti con valvole termostatiche, sulla distribuzione esistente.",
   "status": "approved"
  },
  {
   "id": "a3",
   "text": "La deviatrice a tre vie sta sul primario a monte del volano: via dritta al volano, terza via al serpentino del bollitore. La priorità sanitaria è una logica di regolazione: sul grafo si vede la valvola, non la priorità.",
   "status": "approved"
  },
  {
   "id": "a4",
   "text": "Circolatore del secondario sulla mandata ai radiatori, a valle del volano.",
   "status": "approved"
  },
  {
   "id": "a5",
   "text": "Il quadro è quello esistente dell'appartamento; si aggiungono l'interruttore magnetotermico differenziale della linea PdC e il relè del circolatore.",
   "status": "approved"
  },
  {
   "id": "a6",
   "text": "La caldaia esistente si dismette e non compare nello schema; nessun ricircolo sanitario.",
   "status": "approved"
  },
  {
   "id": "a7",
   "text": "Lunghezze stimate dal progettista: macchina-centrale 8 m (primario 16 m andata e ritorno), quadro-macchina 30 m; quadro-lavanderia stimato 22 m; tratti in centrale (secondario, acqua fredda, ACS) stimati 2-4 m.",
   "status": "approved"
  },
  {
   "id": "a8",
   "text": "Termostato: quello esistente, ricablato dalla lavanderia alla pompa di calore (8 m). Marca e modello da definire.",
   "status": "approved"
  },
  {
   "id": "a9",
   "text": "Salto termico del secondario 10 K sul carico di progetto di 7,1 kW (analisi energetica), per il diametro del tratto in centrale.",
   "status": "approved"
  }
 ],
