 "assumptions": [
  {
   "id": "a1",
   "text": "Il circolatore è alimentato dal quadro attraverso il contatto del termostato ambiente, senza relè: la pompa di calore regola da sé e non comanda il circolatore. Se la portata del contatto non basta per il circolatore, dimmelo e metto un relè d'appoggio comandato dal termostato.",
   "status": "proposed"
  },
  {
   "id": "a2",
   "text": "Sezione e lunghezza dei cavi non date: la linea del circolatore va dal quadro al termostato e torna al circolatore, e senza i due tratti la distinta la lascia DA DEFINIRE.",
   "status": "proposed"
  }
 ],
