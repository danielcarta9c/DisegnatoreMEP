 "assumptions": [
  {
   "id": "a-plenum",
   "status": "approved",
   "text": "Il plenum motorizzato Airzone a 4 uscite: la voce del catalogo a quattro serrande."
  },
  {
   "id": "a-zone",
   "status": "approved",
   "text": "Zone: 4 uscite e 3 zone. Le due bocchette del soggiorno (sopra il varco e sulla veletta a x=1) sono due serrande asservite allo stesso termostato Z3. Il grafo non ha un modo di dire l'asservimento: lo dicono le etichette Z3 sulle due bocchette."
  },
  {
   "id": "a-bus-ordine",
   "status": "approved",
   "text": "Bus ai termostati 7, 5 e 9 m: letti nell'ordine in cui il testo elenca le zone (camera matrimoniale 7 m, camera singola 5 m, soggiorno 9 m)."
  },
  {
   "id": "a-sezioni-mancanti",
   "status": "proposed",
   "text": "Sezioni e lunghezze che il testo non da': la sezione del cavo bus Airzone ai termostati; la sezione e la lunghezza del collegamento fra la centrale Airzone e l'unita' interna; la lunghezza del tratto fra sezionatore e unita' esterna (i 18 m sono stati messi fra quadro e sezionatore). Senza, quei tratti restano senza scritta o con DA DEFINIRE."
  },
  {
   "id": "a-diretti",
   "status": "approved",
   "text": "Raccordi diretti, lunghezza zero: il plenum attaccato alla bocca di mandata della UI; la ripresa 800x300 sotto la UI, nel disimpegno; il cablaggio fra centrale Airzone e motori delle serrande, di fabbrica."
  },
  {
   "id": "a-condensa",
   "status": "approved",
   "text": "Condensa: 8 m di PVC Ø32 dalla UI al sifone, e il sifone sull'allaccio allo scarico della cucina. La pompa di condensa e' a bordo della UI (non disegnata come pezzo)."
  },
  {
   "id": "a-potenza",
   "status": "approved",
   "text": "La potenza 7,1 kW dell'unita' esterna e' quella del testo, nominale; non si dice se in raffrescamento o in riscaldamento. Regime della centrale: fino a 35 kW."
  },
  {
   "id": "a-tabella",
   "status": "proposed",
   "text": "Per la tabella delle apparecchiature e per la distinta mancano: il modello del plenum Airzone e della centrale di zona; le dimensioni delle bocchette; i dati di scheda dell'unita' esterna (precarica fino a m, carica aggiuntiva g/m, lunghezza massima); l'attacco della condensa della UI; la protezione nel quadro delle due linee. Se non li dai, quelle celle restano vuote o DA DEFINIRE."
  },
  {
   "id": "a-cartiglio",
   "status": "proposed",
   "text": "Cartiglio: mancano committente, codice di commessa, indirizzo, titolo e numero della tavola. Senza, la tavola esce in bozza con DA DEFINIRE."
  },
  {
   "id": "a-diametri",
   "status": "approved",
   "text": "Diametri calcolati: non si applica. Sezioni e lunghezze sono date dal progettista, tratto per tratto."
  }
 ],
