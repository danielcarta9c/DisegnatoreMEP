 "assumptions": [
  {
   "id": "a-cartiglio",
   "status": "proposed",
   "text": "Per il cartiglio mancano: committente, codice di commessa, indirizzo dell'intervento, titolo e numero della tavola. Senza, la tavola esce in bozza con «DA DEFINIRE»."
  },
  {
   "id": "a-tabella",
   "status": "proposed",
   "text": "Per la tabella delle apparecchiature mancano: il modello del plenum Airzone e della centrale di zona. Se non li dai, quelle celle restano vuote."
  },
  {
   "id": "a-potenza",
   "status": "approved",
   "text": "La potenza dell'unità esterna è scritta come 7,1 kW, il dato del testo (resa nominale): è quella in raffrescamento? Il regime della centrale (sotto/sopra 35 kW) non si applica a un impianto aria-aria e non è stato scritto."
  },
  {
   "id": "a-soggiorno",
   "status": "approved",
   "text": "Le due bocchette del soggiorno: si è assunto che quella sopra il varco abbia il flessibile da 4 m e quella a x=1 sulla parete nord quello da 6 m (la seconda è più lontana dal plenum). È così? Entrambe sono asservite al termostato del soggiorno: il plenum ha due serrande sulla stessa zona."
  },
  {
   "id": "a-ripresa",
   "status": "approved",
   "text": "La ripresa 800×300 sta sotto la UI: si è assunto un raccordo diretto alla bocca di ripresa della macchina (lunghezza 0), senza canale. È così?"
  },
  {
   "id": "a-plenum",
   "status": "approved",
   "text": "Il plenum è attaccato alla bocca di mandata della UI (raccordo diretto, lunghezza 0), e il comando delle serrande fra centrale e plenum è il cablaggio di fabbrica (lunghezza 0). La centrale di zona è considerata compresa nel kit del plenum Airzone. È così?"
  },
  {
   "id": "a-bus",
   "status": "proposed",
   "text": "Bus ai termostati: il testo dà le lunghezze (7, 5, 9 m) ma non il cavo. Che cavo e'? Senza, sulla tavola la sezione non c'e'."
  },
  {
   "id": "a-alimentazione-ui",
   "status": "approved",
   "text": "La UI non ha una sua alimentazione dal quadro: è alimentata dall'unità esterna attraverso il cavo 4G1,5 (così il testo, che non dà altre linee). La centrale Airzone è alimentata dal quadro senza sezionatore locale. È così?"
  },
  {
   "id": "a-condensa",
   "status": "approved",
   "text": "La UI ha la pompa di condensa a bordo: è scritta come dato della macchina, non è un pezzo della tavola (il catalogo non ha la voce). Il sifone è disegnato fra la UI e l'allaccio allo scarico della cucina."
  },
  {
   "id": "a-reversibile",
   "status": "approved",
   "text": "L'impianto è reversibile (raffrescamento e riscaldamento): le linee frigorifere sono le stesse nelle due stagioni."
  },
  {
   "id": "a-diametri",
   "status": "approved",
   "text": "Diametri: il testo dà le sezioni di ogni tratto (linee frigo, flessibili, cavi): si trascrivono, non si calcolano. Non ci sono reti ad acqua da dimensionare."
  },
  {
   "id": "a-distinta",
   "status": "proposed",
   "text": "Per la distinta mancano: le dimensioni delle bocchette; l'attacco condensa della UI; precarica, carica aggiuntiva e lunghezza massima delle linee frigo dell'unità esterna; la protezione nel quadro delle due linee di alimentazione."
  }
 ],
