  "assumptions": [
    {
      "id": "a-cartiglio",
      "text": "Dati del cartiglio dati dal progettista: committente Condominio di prova, commessa PROVA-REL-001, indirizzo Via di Prova 7, 00000 Comune di Prova (XX), titolo Schema funzionale della centrale termica, tavola T1.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-tabella",
      "text": "Tabella delle apparecchiature: marche, modelli, portate e prevalenze dei circolatori non sono ancora scelti; il progettista chiede di lasciare le celle vuote.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-diametri",
      "text": "Diametri solo sul circuito dei generatori, ramo del serpentino compreso, dalle potenze e dal salto termico di 5 K. Niente diametri sul secondario dei radiatori (esistente) e sul sanitario (acqua fredda, ACS e ricircolo: portate non disponibili).",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-dt-caldaia",
      "text": "Il salto termico di 5 K lato generatori vale per tutti e tre i generatori, caldaia compresa: il ramo della caldaia si dimensiona su 100 kW con 5 K.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-secondario-esistente",
      "text": "Il circuito secondario dei radiatori, dal volume tecnico con il suo circolatore fino alla distribuzione, e' esistente (precisazione del progettista): niente diametri.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-circolatore-caldaia",
      "text": "La caldaia ha il circolatore a bordo (il progettista): sul suo ramo non c'e' un circolatore dedicato. La voce di catalogo della caldaia non lo dichiara a bordo: il dato e' trascritto fra le sue proprieta'.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-circolatori-pdc",
      "text": "Le pompe di calore hanno il circolatore a bordo, come la macchina di catalogo: sui loro rami non c'e' un circolatore a se'.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-parallelo",
      "text": "I tre generatori in parallelo si uniscono sulla mandata con due raccordi a T e si dividono sul ritorno con due ripartizioni a T. L'ordine, partendo dal volume tecnico, e' quello del testo: le due pompe di calore, poi la caldaia in fondo, uguale su mandata e ritorno.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-ritorno-serpentino",
      "text": "Il ritorno del serpentino del bollitore si unisce con un raccordo a T al ritorno dal volume tecnico, prima delle ripartizioni verso i generatori.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-regolazione",
      "text": "La cascata delle pompe di calore, l'integrazione della caldaia e la priorita' all'ACS sono logiche di regolazione: sul grafo si vedono i tre generatori in parallelo e la valvola deviatrice sulla mandata comune, non la logica.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-carico-scarico",
      "text": "Il testo prevede sul volume tecnico il carico automatico dell'impianto da acquedotto e lo scarico: li aggiunge il pezzo che completa il grafo, non questo grafo.",
      "status": "approved",
      "source_message_refs": [
        "Sul volume tecnico sono previsti il collegamento per il carico automatico dell'impianto da acquedotto e lo scarico."
      ]
    },
    {
      "id": "a-miscelatrice",
      "text": "Il testo prevede la valvola miscelatrice termostatica sull'uscita dell'ACS: la aggiunge il pezzo che completa il grafo, non questo grafo.",
      "status": "approved",
      "source_message_refs": [
        "Sull'uscita è prevista una valvola miscelatrice termostatica."
      ]
    },
    {
      "id": "a-circolatore-secondario",
      "text": "Il circolatore del secondario e' sulla mandata, la posizione convenzionale.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    },
    {
      "id": "a-radiatori",
      "text": "La distribuzione esistente a radiatori degli appartamenti e' rappresentata da un radiatore solo.",
      "status": "approved",
      "source_message_refs": [
        "Risposta del progettista, 29 settembre 2026"
      ]
    }
  ],
