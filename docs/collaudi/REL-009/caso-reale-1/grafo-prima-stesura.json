 "assumptions": [
  {
   "id": "a-reversibile",
   "text": "Le 4 PdC del riscaldamento sono reversibili: primario e secondario portano d'estate acqua refrigerata negli stessi tubi, per cui le reti sono disegnate come acqua di riscaldamento.",
   "status": "approved"
  },
  {
   "id": "a-circolatori-pdc",
   "text": "Le PdC hanno il circolatore a bordo: sul primario non si disegnano pompe esterne (confermato).",
   "status": "approved"
  },
  {
   "id": "a-collettori-copertura",
   "text": "Il parallelo delle PdC (collettore DN50 per le 4 del riscaldamento, DN32 per le 2 dell'ACS, tavola T3) e' disegnato con raccordi a T in catena, ritorno speculare. Il progettista lascia libera la forma dei collettori purche' la tavola sia ordinata con il principio delle autostrade.",
   "status": "approved"
  },
  {
   "id": "a-collettore-ct",
   "text": "Le due pompe di macrozona partono dal collettore esistente in centrale alta: disegnato come una ripartizione a T sulla mandata e una confluenza a T sul ritorno verso il volano.",
   "status": "approved"
  },
  {
   "id": "a-macrozone",
   "text": "Collettori d'appartamento in derivazione lungo la dorsale di ciascuna macrozona (3 sulla macrozona 1, 5 sulla macrozona 2), ritorno speculare.",
   "status": "approved"
  },
  {
   "id": "a-terminali",
   "text": "Ogni collettore d'appartamento ha due uscite con valvole manuali, una verso i fancoil e una verso il pavimento radiante: si disegna un fancoil e un pannello radiante rappresentativi per collettore (confermato). Le valvole stanno sulle uscite del collettore, non su ingresso e uscita dei terminali.",
   "status": "approved"
  },
  {
   "id": "a-contabilizzatore",
   "text": "Tipo B. Il contabilizzatore di calore sul ritorno (DN50, in copertura al piede del volano 1000 l) non ha una voce in catalogo: non e' disegnato.",
   "status": "proposed"
  },
  {
   "id": "a-predisposizione-solare",
   "text": "Tipo B. Il volano ACS ha 6 attacchi (4 usati + 2 predisposti per il solare termico futuro): il catalogo ha solo il volano a 4 attacchi e nessun attacco predisposto/tappato con etichetta, per cui i due tubi 'al solare termico' non si possono disegnare. Il solare non va disegnato.",
   "status": "proposed"
  },
  {
   "id": "a-volume-volano-acs",
   "text": "Volano ACS Cordivari Volano BS GBF 200, 200 l (ordine e targa): confermato.",
   "status": "approved"
  },
  {
   "id": "a-centralizzata",
   "text": "Produzione di ACS centralizzata (confermato): il vaso sanitario va sull'ingresso acqua fredda del bollitore, fra il non ritorno e il bollitore.",
   "status": "approved"
  },
  {
   "id": "a-bollitore",
   "text": "Bollitore da 1000 l a un solo serpentino, esistente, in centrale interrata, caricato dal volano ACS tramite il circolatore sulla mandata del secondario (confermato).",
   "status": "approved"
  },
  {
   "id": "a-limite-intervento",
   "text": "Limite dell'intervento: il retrofit si ferma in centrale alta; il circuito di carico si e' riattaccato alle tubazioni esistenti che scendono al serpentino del bollitore. Bollitore, acqua fredda, ACS, ricircolo (con le sue pompe) sono esistenti in centrale interrata; collettori d'appartamento e terminali sono esistenti. Le reti acqua-fredda e acs sono marcate esistenti; per tutto il resto la skill non sa ancora marcare come esistenti singoli pezzi o tratti, ne' disegnare il limite d'intervento.",
   "status": "proposed"
  },
  {
   "id": "a-ricircolo",
   "text": "Il ricircolo ACS torna dalle utenze e rientra nel bollitore dal suo attacco di ricircolo, con la propria pompa (esistente, in centrale interrata).",
   "status": "approved"
  },
  {
   "id": "a-regolazione",
   "text": "Logica di regolazione non disegnata: cascata delle 4 PdC del riscaldamento, coppia master/slave delle 2 PdC ACS.",
   "status": "approved"
  },
  {
   "id": "a-potenze",
   "text": "6 PdC Shenling HPM-V150W/R3 da 15 kW (targa, resa nominale EN 14511) = 90 kW, regime oltre 35 kW. Marche e modelli confermati dal progettista.",
   "status": "approved"
  },
  {
   "id": "a-ferramenta-foto",
   "text": "Accessori visti nelle foto e nei video (oggi la skill non li sa dichiarare, li aggiunge solo il pezzo che completa): su ogni PdC filtro a Y sul ritorno, valvole a sfera su mandata e ritorno, giunti flessibili inox, sfiato automatico con valvola a sfera sul ritorno, corpo in ottone sull'uscita (probabile ritegno); sul volano 1000 l valvole flangiate, sfiato e sonde; pompe di macrozona Grundfos MAGNA con valvole flangiate a volantino, manometri e termometri; vasi di espansione rossi e bianchi in centrale alta e nel locale del volano ACS; volano ACS con sfiato in testa e scarico; collettore acqua fredda con riduttore di pressione e manometro; miscelatrice termostatica ACS con termometri.",
   "status": "proposed"
  },
  {
   "id": "a-trattamento-acqua",
   "text": "Tipo B. Il dosatore di polifosfati non ha voce in catalogo: non disegnato.",
   "status": "proposed"
  },
  {
   "id": "a-tabella",
   "text": "Per la tabella delle apparecchiature mancano: marca e modello del bollitore 1000 l; sigla delle due Grundfos MAGNA di macrozona; marca e modello della pompa di ricircolo; portata e prevalenza di tutti i circolatori. Se non arrivano, quelle celle restano vuote.",
   "status": "proposed"
  },
  {
   "id": "a-diametri",
   "text": "Diametri: non ancora chiesti esplicitamente. Dati disponibili: riscaldamento 45/40 °C (delta T 5 K, scritto sulle PdC del riscaldamento); circuito di carico del bollitore circa 10 K (60/50 o 65/55 °C, da verificare, scritto a parole sul circolatore). Mancano il salto termico del primario ACS e la potenza o portata del circuito di carico.",
   "status": "proposed"
  },
  {
   "id": "a-cartiglio",
   "text": "Tavola da lasciare in centrale e da allegare alla dichiarazione di conformita'. Mancano titolo e numero della tavola (proposta: 'Schema funzionale centrale termica', T4).",
   "status": "proposed"
  }
 ],
