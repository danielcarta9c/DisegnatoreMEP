 "assumptions": [
  {
   "id": "a1",
   "text": "La linea della pompa di calore è protetta nel quadro da un interruttore magnetotermico differenziale (specifica Nove C §3.2); niente sezionatore locale, che la specifica non chiede come regola. Se lo vuoi, dimmelo e lo metto accanto alla macchina.",
   "status": "proposed"
  },
  {
   "id": "a2",
   "text": "Poli, curva, In, Idn e tipo dell'interruttore non dati: li scrive completa dal manuale Shenling (§7.4 p. 55) e dalla specifica Nove C (§3.3), con la regola «vale il maggiore».",
   "status": "proposed"
  }
 ],
