 "assumptions": [
  {
   "id": "a1",
   "text": "Il testo non dice da dove si alimenta la centrale di zona: si è assunta una linea dedicata dal quadro dell'appartamento (risposta del progettista: sì, 3G1,5 L 10 m).",
   "status": "approved"
  },
  {
   "id": "a2",
   "text": "Il comando a filo si collega al bus P1-P2 dell'unità interna (seconda coppia), non alla centrale di zona (risposta del progettista: sì).",
   "status": "approved"
  },
  {
   "id": "a3",
   "text": "Lunghezze dei rami d'aria, della ripresa, della condensa e delle linee elettriche date dal progettista in risposta (camera 5 m, cameretta 4 m, soggiorno 6 m; ripresa Ø200 1,5 m; condensa Ø32 3 m; quadro-sezionatore 3G2,5 12 m; collegamento 4G1,5 8 m; termostati 2×0,75).",
   "status": "approved"
  },
  {
   "id": "a4",
   "text": "L'unità interna è alimentata dall'unità esterna attraverso il collegamento fra le unità (risposta del progettista: sì).",
   "status": "approved"
  },
  {
   "id": "a5",
   "text": "Marca e modello di unità esterna, unità interna, plenum: non dati; nella tabella restano vuoti.",
   "status": "approved"
  },
  {
   "id": "a6",
   "text": "Distinta materiali: richiesta in PDF. Pianta dei tracciati: non richiesta.",
   "status": "approved"
  },
  {
   "id": "a7",
   "text": "Dati per la distinta dati dal progettista: R32, precarica 15 m, 20 g/m, max 30 m; attacco condensa Øe 20; bocchette 300×100; protezioni; portate. Fornitura predefinita confermata.",
   "status": "approved"
  }
 ],
