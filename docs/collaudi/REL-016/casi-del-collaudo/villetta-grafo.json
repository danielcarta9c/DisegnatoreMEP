 "assumptions": [
  {
   "id": "a1",
   "text": "Volano: il testo non dice se e' in serie o separatore. Prima interpretazione (confermata dal progettista): volano a quattro attacchi, separatore fra primario e impianto.",
   "status": "approved"
  },
  {
   "id": "a2",
   "text": "Il catalogo non ha un collettore a 6 vie (il collettore con ritorno ha due coppie): il collettore non e' disegnato, l'impianto a pavimento e' un pannello rappresentativo con la scritta. Il progettista: procedi senza.",
   "status": "approved"
  },
  {
   "id": "a3",
   "text": "Acqua fredda e utenze del bollitore non sono nel testo: aggiunte come confini (progettista: si').",
   "status": "approved"
  },
  {
   "id": "a4",
   "text": "Alimentazione del circolatore dal quadro: non detta, confermata dal progettista (seconda uscita del quadro).",
   "status": "approved"
  },
  {
   "id": "a5",
   "text": "Regola la pompa di calore (testo esplicito): niente regolatore esterno; sonde e comandi alla macchina.",
   "status": "approved"
  },
  {
   "id": "a6",
   "text": "Diametri: non richiesti. Distinta e pianta: non richieste. Marca e modello: non dati.",
   "status": "approved"
  },
  {
   "id": "a7",
   "text": "Deviatrice: via dritta al volano, terza via al bollitore (D-196).",
   "status": "approved"
  }
 ],
